# No trailing slash: a worktree that links node_modules to another checkout
# has a symlink there, which `node_modules/` does not match.
node_modules
.next/
out/
build/
dist/
# The signed extension package: built on deploy, signed with a key that is
# never committed (extension/pack.mjs).
extension/package/

.env
.env.local
.env.*.local

npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

.DS_Store
*.pem
.vscode/
.idea/

coverage/

# Local dev email driver output
.mail-outbox/

next-env.d.ts
tsconfig.tsbuildinfo
