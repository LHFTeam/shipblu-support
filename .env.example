# Copy to .env.local (web) / .env (worker) and fill in.

NODE_ENV=development

# --- Database -----------------------------------------------------------
# Supavisor TRANSACTION pooler (port 6543) — all normal app queries.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Supavisor SESSION pooler (port 5432) — required for LISTEN/NOTIFY.
DATABASE_URL_SESSION=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- App ----------------------------------------------------------------
APP_URL=http://localhost:3000
# openssl rand -hex 32
APP_SECRET=

# --- Supabase Storage (attachments) ------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# --- Email --------------------------------------------------------------
# local = write outbound mail to .mail-outbox/ instead of sending
EMAIL_PROVIDER=local
EMAIL_API_KEY=
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=support@shipblu.com
EMAIL_FROM_NAME=ShipBlu Support
EMAIL_REPLY_DOMAIN=shipblu.com

# --- WhatsApp (Meta Cloud API) -----------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Facebook & Instagram ----------------------------------------------
# One Page access token covers both: an Instagram professional account is
# reached through the Facebook Page it is linked to. Prefer a System User
# token, which does not expire.
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
# Both fall back to the WhatsApp values when one Meta app serves all three.
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Worker -------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
