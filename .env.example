# Copy to .env.local (web) / .env (worker) and fill in.

NODE_ENV=development

# --- Database -----------------------------------------------------------
# Supavisor TRANSACTION pooler (port 6543) — all normal app queries.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Supavisor SESSION pooler (port 5432) — required for LISTEN/NOTIFY.
DATABASE_URL_SESSION=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- App ----------------------------------------------------------------
APP_URL=http://localhost:3000
# openssl rand -hex 32
APP_SECRET=

# --- Help centre and chat widget ---------------------------------------
# Hostname the public help centre answers on, e.g. support.shipblu.com. Unset
# means it is reachable at /en and /ar on this host, which is what local
# development and the Render service URL use.
KB_PUBLIC_HOST=
# Comma-separated origins allowed to embed the chat widget, e.g.
# https://shipblu.com. Our own origin is always allowed and the help centre
# serves the widget from its own hostname, so only sites that are not ours go
# here — an origin missing from this list gets an empty box.
WIDGET_ALLOWED_ORIGINS=

# --- Supabase Storage (attachments) ------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# --- Email --------------------------------------------------------------
# local = write outbound mail to .mail-outbox/ instead of sending
EMAIL_PROVIDER=local
EMAIL_API_KEY=
# Basic Auth password on Postmark's inbound webhook URL. With
# EMAIL_PROVIDER=postmark an unset value refuses all inbound mail. The local
# driver needs none, and accepts inbound only outside NODE_ENV=production.
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=support@shipblu.com
EMAIL_FROM_NAME=ShipBlu Support
EMAIL_REPLY_DOMAIN=shipblu.com

# --- WhatsApp (Meta Cloud API) -----------------------------------------
# Which number and business account to use. The credentials they are used with
# are the Meta ones below — one app serves all three channels.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# --- Meta credentials (WhatsApp, Messenger, Instagram) -----------------
# One app serves all three channels, so these are the only credentials any of
# them needs.
#
# The Page token sends everywhere and lists WhatsApp templates — an Instagram
# professional account is reached through the Facebook Page it is linked to, so
# there is no separate Instagram credential. Prefer a System User token, which
# does not expire; a user token lasts about 24 hours.
META_PAGE_ACCESS_TOKEN=
# Verifies X-Hub-Signature-256 on inbound webhooks, and answers Meta's
# subscription handshake, for all three channels.
META_APP_SECRET=
META_VERIFY_TOKEN=

FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# The Instagram Login pair. Leave both empty unless the Instagram account is
# connected through "API setup with Instagram login" rather than through the
# Facebook Page it is linked to.
#
# That setup is a second identity inside the same Meta app: it signs the
# `instagram` object's webhooks with its own app secret, and it is served from
# graph.instagram.com with its own access token — the Page token is refused
# there. Both symptoms are silent. An unset app secret answers every Instagram
# delivery 403 and files it unverified; a wrong token is refused by Graph with a
# sentence that names no cause.
META_INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# Seals the WhatsApp business tokens Embedded Signup stores in the database —
# the one credential that is stored rather than named. Any high-entropy string
# of 32 characters or more: `openssl rand -base64 32`. Never derive it from
# APP_SECRET, and never name it WHATSAPP_TOKEN_*. The previous key is set only
# while a rotation is in progress.
WHATSAPP_CREDENTIAL_KEY=
WHATSAPP_CREDENTIAL_KEY_PREVIOUS=

# --- Shipments ----------------------------------------------------------
# Regular expressions for spotting a tracking number / SBID in message text.
# Unset means the defaults in lib/shipments/detect.ts, which are deliberately
# conservative until the real ShipBlu formats are confirmed.
SHIPMENT_TRACKING_PATTERN=
SHIPMENT_SBID_PATTERN=
# Comma-separated tracking numbers never to link (worked examples in canned
# responses and signatures).
SHIPMENT_IGNORE=

# --- TypeSafe AI --------------------------------------------------------
# The shadow categorisation run only (lib/categorise-ai/), started by hand with
# `npm run job -- backfill_categorise_ai`. Unset means that job reports the key
# is missing and does nothing; nothing on a request path reads either value.
# TYPESAFE_MODEL pins a run to one Jev version instead of the jev-latest alias.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=

# --- Worker -------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
